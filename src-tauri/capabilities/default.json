{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 패널·환경설정·로우데이터 창 공통 권한",
  "windows": ["main", "settings", "rawdata", "help"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:event:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
