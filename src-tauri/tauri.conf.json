{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskTray",
  "version": "0.1.0",
  "identifier": "com.bts.tasktray",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TaskTray",
        "width": 360,
        "height": 720,
        "minWidth": 300,
        "minHeight": 400,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
