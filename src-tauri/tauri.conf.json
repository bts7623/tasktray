{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskTray",
  "version": "1.0.0",
  "identifier": "com.bts.tasktray",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TaskTray",
        "width": 360,
        "height": 720,
        "minWidth": 300,
        "minHeight": 400,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BTS",
    "shortDescription": "개인 업무 스케줄 관리 트레이 앱 (Made by BTS)",
    "longDescription": "TaskTray는 수시 업무를 즉시 메모하고, 완료 업무의 flow 등록 여부를 추적하며, 누적 실적을 리포트로 내보내는 초경량 개인용 도구입니다. Made by BTS.",
    "licenseFile": "installer-info.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
