# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 git 제외)
# 값 자체는 비밀번호 관리자(Bitwarden/1Password/KeePass 등)에 보관하고, 새 PC에서 복원합니다.

# --- 웹/동기화 빌드에 필요 (없으면 데스크톱 로컬 기능만 동작) ---
# Supabase anon 키는 웹 번들에 어차피 실려 배포됨(=공개값, RLS로 보호). 그래도 저장소엔 두지 않음.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 자동 업데이트 설치파일 릴리스 빌드에 필요 (D-30) ---
# 개인키 파일(tasktray-updater.key)은 이 변수가 아니라 "파일 자체"를 안전 보관·복원해야 함.
# 빌드 시: $env:TAURI_SIGNING_PRIVATE_KEY = Get-Content tasktray-updater.key -Raw
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
